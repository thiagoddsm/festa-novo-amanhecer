/**
 * @fileOverview
 * Core Philosophy: This ruleset enforces strict, path-based access control for a cashless payment system.
 * It prioritizes Authorization Independence by denormalizing data (specifically, the cardId in the transactions subcollection) to avoid costly `get()` calls in security rules.
 *
 * Data Structure:
 * - /cards/{cardId}: Stores card details.
 * - /cards/{cardId}/transactions/{transactionId}: Stores transactions for a specific card.
 * - /points_of_sale/{pdvId}: Stores details for each point of sale.
 *
 * Key Security Decisions:
 * - Transactions are secured by checking the API key in the points_of_sale collection.
 * - No user listing is allowed for any collection to prevent information disclosure.
 * - The default security posture is deny-all unless explicitly allowed by a rule.
 *
 * Denormalization for Authorization:
 * - The `transactions` subcollection under each card denormalizes `cardId` to avoid relying on parent document data for security rules.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows read and write access to card documents.
     * @path /cards/{cardId}
     * @allow (get, list) if false;
     * @allow (create, update, delete) if false;
     * @deny (get, list) Always denies listing or getting all cards.
     * @deny (create, update, delete) Always denies creating, updating, or deleting cards.
     * @principle Data for Cards is NOT publicly accessible
     */
    match /cards/{cardId} {
      allow get, list: if false;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows managing transactions for a specific card.
     * @path /cards/{cardId}/transactions/{transactionId}
     * @allow create: if false;
     * @allow update: if false;
     * @allow delete: if false;
     * @allow get: if false;
     * @allow list: if false;
     * @deny create: Always denies creation of transactions.
     * @deny update: Always denies updating transactions.
     * @deny delete: Always denies deleting transactions.
     * @deny get: Always denies getting transactions.
     * @deny list: Always denies listing transactions.
     * @principle Enforces that transactions are only accessible or writable by authorized PDVs with the correct API key.
     */
    match /cards/{cardId}/transactions/{transactionId} {
      allow get, list: if false;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows read and write access to point of sale documents.
     * @path /points_of_sale/{pdvId}
     * @allow get, list: if false;
     * @allow create, update, delete: if false;
     * @deny get, list: Always denies listing or getting all point of sales.
     * @deny create, update, delete: Always denies creating, updating, or deleting point of sales.
     * @principle Data for PointOfSale is NOT publicly accessible
     */
    match /points_of_sale/{pdvId} {
      allow get, list: if false;
      allow create, update, delete: if false;
    }
  }
}