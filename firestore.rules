rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ATENÇÃO: Regras 100% liberais para desenvolvimento.
    // Permitem leitura e escrita em todo o banco de dados.
    // SUBSTITUA por regras seguras antes de ir para produção.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
