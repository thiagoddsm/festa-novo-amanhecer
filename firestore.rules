/**
 * @file Firestore Security Rules
 * @core_philosophy This ruleset provides completely open access for all read and write operations on all collections. This is ONLY suitable for the prototyping phase.
 * @data_structure The database contains three top-level collections: `cards`, `points_of_sale`, and the subcollection `transactions` under each card.
 * @key_security_decisions All read and write operations are allowed without authentication or authorization checks. This is highly insecure and should be replaced with proper rules for production.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows all read and write operations on cards.
     * @path /cards/{cardId}
     * @allow (create) Any user can create a card.
     * @allow (read) Any user can read a card.
     * @allow (write) Any user can update or delete a card.
     * @deny (none) This rule is completely open for prototyping.
     * @principle Allows all access for rapid prototyping.
     */
    match /cards/{cardId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows all read and write operations on transactions within a card.
     * @path /cards/{cardId}/transactions/{transactionId}
     * @allow (create) Any user can create a transaction for a card.
     * @allow (read) Any user can read a transaction for a card.
     * @allow (write) Any user can update or delete a transaction for a card.
     * @deny (none) This rule is completely open for prototyping.
     * @principle Allows all access for rapid prototyping.
     */
    match /cards/{cardId}/transactions/{transactionId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows all read and write operations on points of sale.
     * @path /points_of_sale/{pdvId}
     * @allow (create) Any user can create a point of sale.
     * @allow (read) Any user can read a point of sale.
     * @allow (write) Any user can update or delete a point of sale.
     * @deny (none) This rule is completely open for prototyping.
     * @principle Allows all access for rapid prototyping.
     */
    match /points_of_sale/{pdvId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }
  }
}