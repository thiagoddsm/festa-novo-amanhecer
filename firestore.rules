rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ATENÇÃO: Essas regras permitem acesso total ao seu banco de dados.
    // Elas são destinadas apenas para desenvolvimento e devem ser
    // substituídas por regras de segurança adequadas antes da produção.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
