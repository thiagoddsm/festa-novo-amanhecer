{
  "entities": {
    "Card": {
      "title": "Card",
      "description": "Represents a cashless card in the system.",
      "type": "object",
      "properties": {
        "qr_code_id": {
          "type": "string",
          "description": "The unique identifier for the QR code."
        },
        "saldo_centavos": {
          "type": "number",
          "description": "The balance of the card in cents."
        },
        "status": {
          "type": "string",
          "description": "The status of the card.",
          "enum": [
            "ATIVO",
            "INATIVO",
            "BLOQUEADO"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp when the card was created."
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp when the card was last updated."
        },
        "nome_cliente": {
          "type": "string",
          "description": "The name of the customer."
        },
        "telefone_cliente": {
          "type": "string",
          "description": "The phone number of the customer."
        }
      },
      "required": [
        "qr_code_id",
        "saldo_centavos",
        "status"
      ]
    },
    "CardDetails": {
      "title": "CardDetails",
      "description": "Represents the details of a card returned from a query.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "The Firestore document ID."
        },
        "qr_code_id": {
          "type": "string"
        },
        "saldo_centavos": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": [
            "ATIVO",
            "INATIVO",
            "BLOQUEADO"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "nome_cliente": {
          "type": "string"
        },
        "telefone_cliente": {
          "type": "string"
        }
      }
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Represents a single financial transaction.",
      "type": "object",
      "properties": {
        "cartao_id": {
          "type": "string",
          "description": "The Firestore document ID of the card."
        },
        "pdv_id": {
          "type": "number",
          "description": "The ID of the point of sale."
        },
        "tipo": {
          "type": "string",
          "description": "The type of transaction.",
          "enum": [
            "RECARGA",
            "VENDA",
            "REEMBOLSO"
          ]
        },
        "valor_centavos": {
          "type": "number",
          "description": "The value of the transaction in cents."
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp when the transaction occurred."
        }
      },
      "required": [
        "cartao_id",
        "pdv_id",
        "tipo",
        "valor_centavos"
      ]
    },
    "TransactionDetails": {
      "title": "TransactionDetails",
      "description": "Represents the detailed view of a transaction for display.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "cartao_id": {
          "type": "string"
        },
        "card_qr_code_id": {
          "type": "string",
          "description": "The QR Code ID of the associated card."
        },
        "pdv_id": {
          "type": "number"
        },
        "pdv_nome": {
          "type": "string",
          "description": "The name of the Point of Sale."
        },
        "tipo": {
          "type": "string",
          "enum": [
            "RECARGA",
            "VENDA",
            "REEMBOLSO"
          ]
        },
        "valor_centavos": {
          "type": "number"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "auth": {
    "providers": []
  },
  "firestore": {
    "/cards/{cardId}": {
      "schema": {
        "$ref": "#/entities/Card"
      },
      "description": "Stores information about each cashless card."
    },
    "/transactions/{transactionId}": {
      "schema": {
        "$ref": "#/entities/Transaction"
      },
      "description": "Stores all financial transactions."
    }
  }
}
